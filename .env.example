# GeoAI Mineral Labs
# Example environment configuration
#
# Copy this file to ".env" only when a laboratory requires
# environment variables.
#
# Never commit real credentials, API keys, tokens, passwords,
# private endpoints, or other sensitive information.

# ------------------------------------------------------------
# General configuration
# ------------------------------------------------------------

GEOAI_ENV=development
LOG_LEVEL=INFO
DATA_ROOT=./data

# ------------------------------------------------------------
# Optional external services
# ------------------------------------------------------------
# Add variables only when they are actually required by a lab.
# Keep real values exclusively in the local .env file.

