# ============================================================
# GEOAI MINERAL LABS
# Cross-platform Git attributes
# ============================================================

# Normalize text files in the repository
* text=auto

# Source code
*.py      text eol=lf
*.ipynb   text eol=lf

# Configuration
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.json    text eol=lf

# Documentation
*.md      text eol=lf
*.txt     text eol=lf

# Shell scripts
*.sh      text eol=lf

# Windows scripts
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Common binary geospatial/data formats
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.pdf     binary
*.tif     binary
*.tiff    binary
*.parquet binary
*.gpkg    binary
*.shp     binary
*.dbf     binary
*.shx     binary
